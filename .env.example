# VajraX — Environment Variables Reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# =============================================================================
# COMMON / SHARED
# =============================================================================

# Which station this Edge backend serves
# Values: maitri | bharati
STATION_ID=maitri

# Logging
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json             # json | console

# =============================================================================
# EDGE BACKEND
# =============================================================================

# TimescaleDB connection for this Edge instance
# Maitri : postgresql+asyncpg://vajrax_edge:edge_secret_dev@localhost:5433/vajrax_edge
# Bharati: postgresql+asyncpg://vajrax_edge:edge_secret_dev@localhost:5434/vajrax_edge
DATABASE_URL=postgresql+asyncpg://vajrax_edge:edge_secret_dev@localhost:5433/vajrax_edge

# Redis for Edge (queue, pub/sub, dedup cache)
# Maitri : redis://localhost:6380/0
# Bharati: redis://localhost:6381/0
REDIS_URL=redis://localhost:6380/0

# Path to the station YAML config (mounted by Docker)
STATION_CONFIG_PATH=/app/config/maitri.yaml

# Port the Edge API listens on
INGEST_PORT=8100

# Ed25519 private key for signing outbound sync envelopes
# (PEM file path, auto-generated by make keygen-edge)
EDGE_PRIVATE_KEY_PATH=/app/keys/maitri_private.pem

# MQTT broker for uplink to Cloud HQ
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883       # 8883 for TLS/mTLS | 1883 for plain (dev only)
MQTT_USE_TLS=true
MQTT_CA_CERT_PATH=/app/certs/ca.crt
MQTT_CLIENT_CERT_PATH=/app/certs/maitri.crt
MQTT_CLIENT_KEY_PATH=/app/certs/maitri.key

# Black-box recorder settings
BLACK_BOX_PRE_EVENT_S=300   # 5 minutes pre-event buffer
BLACK_BOX_POST_RESOLUTION_S=900   # 15 minutes post-resolution capture
BLACK_BOX_FRAME_INTERVAL_S=5     # Frame capture interval

# Alert deduplication TTL (seconds)
ALERT_DEDUP_TTL_S=3600

# =============================================================================
# CLOUD BACKEND (NCPOR HQ)
# =============================================================================

# PostgreSQL/TimescaleDB for Cloud
DATABASE_URL=postgresql+asyncpg://vajrax_cloud:cloud_secret_dev@localhost:5435/vajrax_cloud

# Redis for Cloud (refresh tokens, WebSocket pub/sub, analytics cache)
REDIS_URL=redis://localhost:6382/0

# JWT settings
# IMPORTANT: Change CLOUD_JWT_SECRET in production!
CLOUD_JWT_SECRET=dev-insecure-secret-change-in-prod-!!!
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Comma-separated list of station IDs this Cloud instance serves
CLOUD_STATION_IDS=maitri,bharati

# Directory containing per-station Ed25519 PUBLIC keys
# File naming convention: {station_id}_public.pem
CLOUD_PUBKEY_DIR=/app/keys/

# MQTT subscriber settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_USE_TLS=true
MQTT_CA_CERT_PATH=/app/certs/ca.crt
MQTT_CLIENT_CERT_PATH=/app/certs/cloud.crt
MQTT_CLIENT_KEY_PATH=/app/certs/cloud.key

# Heartbeat timeout — station declared offline after N minutes of silence
CLOUD_HEARTBEAT_TIMEOUT_MINUTES=15

# MinIO / S3-compatible object storage (for black-box frames and AI models)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=vajrax_minio
MINIO_SECRET_KEY=minio_secret_dev
MINIO_BUCKET_BLACKBOX=vajrax-blackbox
MINIO_BUCKET_MODELS=vajrax-ai-models
MINIO_USE_SSL=false

# =============================================================================
# SIMULATOR (dev / testing only)
# =============================================================================

SIM_STATIONS=maitri,bharati
SIM_TICK_INTERVAL_S=5
SIM_LINK_SIM_ENABLED=true
TOXIPROXY_HOST=localhost
TOXIPROXY_PORT=8474

# =============================================================================
# INFRASTRUCTURE
# =============================================================================

# Docker image tags
VAJRAX_VERSION=0.1.0
POSTGRES_VERSION=16
REDIS_VERSION=7
MOSQUITTO_VERSION=2.0
MINIO_VERSION=RELEASE.2024-04-06T05-26-02Z
